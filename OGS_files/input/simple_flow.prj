    </media>


    <time_loop>
        <processes>
            <process ref="LiquidFlow">
                <nonlinear_solver>basic_picard</nonlinear_solver>
                <time_discretization>
                    <type>BackwardEuler</type>
                </time_discretization>
                <convergence_criterion>
                    <type>DeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstol>1e-12</abstol>
                </convergence_criterion>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0</t_initial>
                    <t_end>1800000</t_end>     <!-- total simulation time = 500 hrs -->
                    <timesteps>
                        <pair>
                            <repeat>500</repeat>  <!-- total steps -->
                            <delta_t>3600</delta_t> <!-- sec per step -->
                        </pair>
                    </timesteps>
                </time_stepping>
            </process>
        </processes>


        <output>
            <type>VTK</type>
            <prefix>result</prefix>
            <timesteps>
                <pair>
                    <repeat>10</repeat>   <!-- output 10 times total -->
                    <each_steps>5</each_steps>  <!-- output every 5 solver steps -->
                </pair>
            </timesteps>
            <variables>
                <variable>pressure</variable>
            </variables>
        </output>
    </time_loop>

    <parameters>
        <parameter>
            <name>pressure_ic</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>p_injection</name>
            <type>Constant</type>
            <value>5e6</value>
        </parameter>
        <parameter>
            <name>p_production</name>
            <type>Constant</type>
            <value>1e6</value>
        </parameter>
        <parameter>
            <name>q_injection</name>
            <type>Constant</type>
            <value>1e6</value>
        </parameter>
    </parameters>

    <process_variables>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>pressure_ic</initial_condition>

            <boundary_conditions>

                <!-- Seal upper well -->
                <boundary_condition>
                    <type>Dirichlet</type>
                    <mesh>Well1_top</mesh>
                    <parameter>p_injection</parameter> <!-- same as injection or slightly lower -->
                </boundary_condition>

                <!-- Bottom well 1: injection -->
                <boundary_condition>
                    <type>Dirichlet</type>
                    <mesh>Well1_bottom</mesh>
                    <parameter>p_injection</parameter>
                </boundary_condition>

                <!-- Production well 2 bottom: low pressure -->
                <boundary_condition>
                    <type>Dirichlet</type>
                    <mesh>Well2_bottom</mesh>
                    <parameter>p_production</parameter>
                </boundary_condition>


            </boundary_conditions>

            <source_terms>
                <!-- Injection volumetric source into bottom only -->
                <source_term>
                    <type>Volumetric</type>
                    <mesh>Well1_bottom</mesh>
                    <parameter>q_injection</parameter>
                </source_term>
            </source_terms>

        </process_variable>
    </process_variables>


    <nonlinear_solvers>
        <nonlinear_solver>
            <name>basic_picard</name>
            <type>Picard</type>
            <max_iter>50</max_iter>
            <linear_solver>linear_solver</linear_solver>
        </nonlinear_solver>
    </nonlinear_solvers>

    <linear_solvers>
        <linear_solver>
            <name>linear_solver</name>
            <eigen>
                <solver_type>CG</solver_type>
                <precon_type>DIAGONAL</precon_type>
                <max_iteration_step>10000</max_iteration_step>
                <error_tolerance>1e-12</error_tolerance>
            </eigen>
        </linear_solver>
    </linear_solvers>

</OpenGeoSysProject>
