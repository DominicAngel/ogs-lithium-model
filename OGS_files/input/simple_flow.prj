<?xml version="1.0" encoding="ISO-8859-1"?>
<OpenGeoSysProject>

    <geometry>simple_geometry.gml</geometry>

    <meshes>
        <mesh>mesh6_materials.vtu</mesh>

        <mesh>Layer5_bottom.vtu</mesh>
        <mesh>Layer4_caprock2.vtu</mesh>
        <mesh>Layer3_Reservoir.vtu</mesh>
        <mesh>Layer2_caprock1.vtu</mesh>
        <mesh>Layer1_Top.vtu</mesh>
        <mesh>Well1_upper.vtu</mesh>
        <mesh>Well1_middle.vtu</mesh>
        <mesh>Well1_bottom.vtu</mesh>
        <mesh>Well1_top.vtu</mesh>
        <mesh>Well2_upper.vtu</mesh>
        <mesh>Well2_middle.vtu</mesh>
        <mesh>Well2_bottom.vtu</mesh>
    </meshes>


    <processes>
        <process>
            <name>LiquidFlow</name>
            <type>LIQUID_FLOW</type>
            <integration_order>2</integration_order>
            <specific_body_force>0 0 0</specific_body_force>
            <process_variables>
                <process_variable>pressure</process_variable>
            </process_variables>
        </process>
    </processes>


    <media>

        <!-- Layer5_bottom: outer layer -->
        <medium id="101">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property>
                            <name>viscosity</name>
                            <type>Constant</type>
                            <value>1e-3</value>
                        </property>
                        <property>
                            <name>density</name>
                            <type>Constant</type>
                            <value>1000</value>
                        </property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property>
                    <name>reference_temperature</name>
                    <type>Constant</type>
                    <value>293.15</value>
                </property>
                <property>
                    <name>permeability</name>
                    <type>Constant</type>
                    <value>1e-16</value>
                </property>
                <property>
                    <name>porosity</name>
                    <type>Constant</type>
                    <value>0.05</value>
                </property>
                <property>
                    <name>storage</name>
                    <type>Constant</type>
                    <value>1e-6</value>
                </property>
            </properties>
        </medium>

